{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lipwise",
  "version": "0.1.0",
  "identifier": "app.lipwise.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Lipwise",
        "url": "index.html",
        "width": 980,
        "height": 720,
        "minWidth": 780,
        "minHeight": 540,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Lipwise Overlay",
        "url": "overlay.html",
        "width": 340,
        "height": 72,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2RkQwQ0NGQzAxNzMzNUIKUldSYk14ZkF6d3o5Vm1zTEM4dGJYcERHSmUwMUpMWE5ESFl3cGZuTHowUHhHMStNQVdrNUZzTXYK",
      "endpoints": [
        "https://github.com/lnenad/lipwise/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
